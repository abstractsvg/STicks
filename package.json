{
  "name": "sticks",
  "version": "0.1.0",
  "description": "A recreation of x8rr/sapphire for the STomp proxy engine",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./path": {
      "types": "./lib/index.d.cts",
      "default": "./lib/index.cjs"
    }
  },
  "files": [
    "src",
    "static",
    "lib",
    "README.md"
  ],
  "keywords": [
    "stomp",
    "proxy",
    "chrome-extensions",
    "web-proxy"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/core.test.ts test/messaging.test.ts",
    "example": "vite --config examples/vite.config.js",
    "example:build": "vite build --config examples/vite.config.js"
  },
  "peerDependencies": {
    "@sysce/stomp": ">=4.2.0-0"
  },
  "devDependencies": {
    "@mercuryworkshop/epoxy-transport": "^3.0.2",
    "@mercuryworkshop/wisp-js": "^0.5.3",
    "@sysce/stomp": "4.2.0-nightly.202611111511.g95abb9f",
    "typescript": "~7.0.2",
    "vite": "^8.3.7"
  }
}
