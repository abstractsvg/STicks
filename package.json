{
  "name": "sticks",
  "version": "0.1.0",
  "description": "A recreation of x8rr/sapphire for the STomp proxy engine",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./path": {
      "types": "./lib/index.d.cts",
      "default": "./lib/index.cjs"
    }
  },
  "files": [
    "src",
    "static",
    "lib",
    "README.md"
  ],
  "keywords": [
    "stomp",
    "proxy",
    "chrome-extensions",
    "web-proxy"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/core.test.ts test/messaging.test.ts"
  },
  "peerDependencies": {
    "@sysce/stomp": ">=4.2.0-0"
  },
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
